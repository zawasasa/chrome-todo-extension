{
  "manifest_version": 3,
  "name": "ささっとeverytodo",
  "version": "1.12",
  "description": "A simple and efficient todo list extension for Chrome",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open ささっとeverytodo"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}