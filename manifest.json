{
  "manifest_version": 3,
  "name": "ささっとeverytodo",
  "version": "1.0.2",
  "description": "A simple and efficient todo list extension for Chrome",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open ささっとeverytodo"
  },
  "icons": {
    "16": "icons/icon16.jpg",
    "48": "icons/icon48.jpg",
    "128": "icons/icon128.jpg"
  }
}